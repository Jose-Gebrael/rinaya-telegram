# Copy to .env (local development). On the VPS the file is also named .env;
# .env.prod is only a local draft of it, never loaded by the code.
# .env keeps the same headers and order as this file, with no explanations.

# ── Telegram ──────────────────────────────────────────────────────────────────
# The bot's token from @BotFather. Never logged, never committed.
TELEGRAM_BOT_TOKEN=
# The community supergroup's id (starts with -100). docs/setup.md says how to find it.
TELEGRAM_GROUP_ID=
# The group's invite link with "approve new members" on (Rewire's and rinaya.org's
# .env hold the same value): anyone can open it, the bot decides who gets in.
TELEGRAM_INVITE_URL=
# Members already in the group who never connect are removed after this moment
# (ISO, e.g. 2026-10-23T12:00:00Z: 2 days after the announcement). Empty: nobody is removed for not connecting.
TELEGRAM_GRACE_UNTIL=
# Minutes between sweeps (removals on lapsed access, welcome-back messages). Default 10.
TELEGRAM_SWEEP_MINUTES=10
# Only for `npm run import-members` (my.telegram.org → API development tools).
TELEGRAM_API_ID=
TELEGRAM_API_HASH=

# ── Database ──────────────────────────────────────────────────────────────────
# The local dev database every Rinaya project shares: the rinaya-db container in
# Docker Desktop (127.0.0.1:3307), the same URL as in ../rinaya/.env. Never the live DB.
DATABASE_URL=mysql://rewire:<password>@127.0.0.1:3307/rinaya_local

# ── Links ─────────────────────────────────────────────────────────────────────
# Where the bot's buttons point. Defaults: https://rewire.rinaya.org and
# https://rinaya.org/rewire/account.
REWIRE_APP_URL=
BILLING_URL=
