generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "mysql"
}

// The models this bot reads and writes in Modern Dating's database
// (rinaya_rewire_db), copied unchanged from ../rinaya-rewire/prisma/schema.prisma,
// which is the only one that pushes it. A change there to one of these is
// copied here in the same session. This repo never pushes the schema.

// Her plan: one row per account, kept current by the checkout and the billing
// sync (CyberSource; src/lib/billing/subscriptions.ts), read to decide her
// access (src/lib/billing/plan.ts).
//   plan:   trial | core | private | sprint
//   status: active | cancelled (paid through current_period_end) | suspended
//           (renewal failed; blocked until the card is updated) | ended
//   promo_code: the promo code she typed at her last checkout
//           (src/lib/billing/promos.ts); its discount applies to every charge
//           until she buys again without it. Prices shown in the app stay full.
model rewire_subscriptions {
  user_id            Int       @id
  plan               String    @db.VarChar(20)
  status             String    @db.VarChar(20)
  current_period_end DateTime  @db.DateTime(0)
  pending_plan       String?   @db.VarChar(20)
  cs_customer_token  String?   @db.VarChar(64)
  cs_subscription_id String?   @db.VarChar(64)
  promo_code         String?   @db.VarChar(32)
  started_at         DateTime  @default(now()) @db.DateTime(0)
  cancelled_at       DateTime? @db.DateTime(0)
  updated_at         DateTime  @default(now()) @updatedAt @db.DateTime(0)

  @@index([cs_subscription_id], map: "rewire_subscriptions_cs_sub_idx")
  @@index([status, current_period_end], map: "rewire_subscriptions_status_end_idx")
}

// Access an admin gave her (admin.rinaya.org → Rewire → Members): a plan, as
// if she had bought it, until ends_at. Not billing: nothing charges for it
// and the billing sync never reads it. While one is live (revoked_at null, ends_at ahead) it decides her
// access over rewire_subscriptions. Ending one early sets revoked_at, and
// changing one ends it and writes a new row, so every grant stays on record.
//   plan: core | private | sprint
model rewire_grants {
  id         Int       @id @default(autoincrement())
  user_id    Int
  plan       String    @db.VarChar(20)
  ends_at    DateTime  @db.DateTime(0)
  note       String?   @db.VarChar(255)
  granted_by String    @db.VarChar(255)
  created_at DateTime  @default(now()) @db.DateTime(0)
  revoked_at DateTime? @db.DateTime(0)
  revoked_by String?   @db.VarChar(255)

  @@index([user_id, ends_at], map: "rewire_grants_user_end_idx")
}

// Her Telegram connection: one row per account that has started connecting.
// Rewire (onboarding, Settings) writes the one-time link token and the skip;
// the bot writes everything else.
//   status: none (not connected yet) | linked (connected, not in the group) |
//           member (in the group) | left (left the group herself) |
//           suspended (removed by the bot because her access closed)
//   link_token: the one-time `t.me/<bot>?start=<token>` code, cleared when used
model telegram_links {
  user_id               Int       @id
  status                String    @default("none") @db.VarChar(20)
  telegram_id           BigInt?   @unique(map: "telegram_links_telegram_id_unique")
  telegram_username     String?   @db.VarChar(64)
  link_token            String?   @unique(map: "telegram_links_link_token_unique") @db.VarChar(64)
  link_token_expires_at DateTime? @db.DateTime(0)
  skipped_at            DateTime? @db.DateTime(0)
  linked_at             DateTime? @db.DateTime(0)
  joined_at             DateTime? @db.DateTime(0)
  kicked_at             DateTime? @db.DateTime(0)
  created_at            DateTime  @default(now()) @db.DateTime(0)
  updated_at            DateTime  @default(now()) @updatedAt @db.DateTime(0)
}

// Everyone the bot has seen in the group, connected or not (joins, leaves,
// messages, and the one-off member list import). Written by the bot only; it
// is how the bot finds members who never connected, to remove them after the
// grace period.
model telegram_members {
  telegram_id   BigInt   @id
  username      String?  @db.VarChar(64)
  first_name    String?  @db.VarChar(128)
  in_group      Boolean  @default(true)
  is_admin      Boolean  @default(false)
  first_seen_at DateTime @default(now()) @db.DateTime(0)
  last_seen_at  DateTime @default(now()) @db.DateTime(0)
}
